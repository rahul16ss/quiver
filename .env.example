# ─── Quiver configuration ─────────────────────────────────────────────
# These are the only environment variables Quiver reads from .env.
# Secrets (API keys) may also be stored in the OS keychain instead of here.
#
# Provider-agnostic, env-driven config (US-1.3 revision 2026-07-28):
# Quiver does NOT bake a model name, base URL, or API key into the source.
# Set LLM_API_BASE_URL, LLM_MODEL_NAME, and LLM_API_KEY below to point at
# any OpenAI-compatible endpoint. A single LLM_API_KEY powers the primary
# LLM and the vision adapter. OLLAMA_API_KEY, VISION_MODEL_API_KEY, and
# CONTEXT7_API_KEY are retired and must not be used.

# ─── Core LLM ─────────────────────────────────────────────────────────
# Point Quiver at any OpenAI-compatible provider (Ollama, OpenRouter,
# OpenAI, vLLM, llama.cpp, etc.). The model must be multimodal if you
# want image support — Quiver sends image content parts to the same
# endpoint, there is no separate vision model.
LLM_API_BASE_URL=
LLM_MODEL_NAME=
LLM_API_KEY=

# ─── Limits ───────────────────────────────────────────────────────────
# Context window budget. Leave headroom for output.
QUIVER_MAX_CONTEXT_TOKENS=120000

# ─── High-sensitivity local model (optional) ──────────────────────────
# When sensitivity routing classifies a turn as "high" (MNPI), the agent
# routes the model call here instead of the cloud endpoint. If not configured,
# high-sensitivity turns are REFUSED rather than sent to the cloud.
# QUIVER_LOCAL_LLM_API_BASE_URL=http://localhost:11434/v1
# QUIVER_LOCAL_LLM_MODEL_NAME=

# ─── Consent gate (optional) ──────────────────────────────────────────
# When enabled, the agent surfaces a pre-action summary and waits for
# approve/decline/exclude before the model call.
# QUIVER_CONSENT_GATE=1

# ─── Security toggles ─────────────────────────────────────────────────
# Block scrape_url requests to private/internal IP ranges (default: enabled).
# Set to 0 to disable (not recommended).
# QUIVER_BLOCK_PRIVATE_IPS=1

# ─── Browser ──────────────────────────────────────────────────────────
# The browser runs headless by default. To show the window (e.g. manual
# sign-in), include browser:visible in QUIVER_AUTONOMY below.

# ─── Session logging ──────────────────────────────────────────────────
# Set to 0 to disable session logging.
QUIVER_SESSION_LOG=1
QUIVER_SESSION_LOG_MAX_CHARS=512

# ─── Web APIs (optional) ──────────────────────────────────────────────
# Powers: web_search, scrape_url, deep_research, find_all, entity_search.
# Get your key at https://platform.parallel.ai
PARALLEL_API_KEY=

# ─── GitHub (optional — developers only) ──────────────────────────────
# Only needed for GitHub tooling (issues, PRs, repos).
GITHUB_TOKEN=

# ─── MCP (Model Context Protocol) ─────────────────────────────────────
# MCP servers are configured in .quiver/mcp.json (not .env).
# See .quiver/mcp.example.json for a sample config.
# MCP tools appear as mcp_<server>_<tool> in the tool list.
# Use /mcp to see connected servers.

# Autonomy grants — comma-separated capabilities the agent can use without asking,
# OR a trust tier: QUIVER_AUTONOMY=tier:build  (observe|propose|build|operate|yolo).
# Available grants: write_file,replace_content,apply_patch,run_command,destructive,
#   privileged,network,secrets,exfiltration,browser,browser:visible,create_tool,
#   web,memory,todo,yolo
# Unset = conservative (ask for everything). yolo tier = bypass ALL gates + sandbox off.
QUIVER_AUTONOMY=
# Ambient self-heal + goal-loop: at task completion the harness runs the maker-checker
# (full) and auto-continues healing until it approves. Set 0 to disable. On by default.
QUIVER_AMBIENT=on
# Max self-heal rounds per ambient completion check (default 5).
# QUIVER_AMBIENT_MAX_ROUNDS=5
# Ambient log retention: auto-purge session logs older than N days at startup (0=keep forever).
QUIVER_LOG_RETENTION_DAYS=30

# ─── Cloud sync (legacy/advanced — opt-in, off by default) ────────────
# See docs/sync.md. Detection alone never enables sync.
# QUIVER_CLOUD_SYNC_ENABLED=1
# QUIVER_CLOUD_SYNC_PATH=
