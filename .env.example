# ─── Quiver configuration ─────────────────────────────────────────────
# These are the only environment variables Quiver reads from .env.
# Secrets (API keys) may also be stored in the OS keychain instead of here.
#
# Env-driven config (no model name, base URL, or API key is baked into source):
# Cloud inference: set OPENROUTER_API_KEY + OPENROUTER_MODEL_PROFILE (OpenRouter is
#   the sole cloud gateway; the harness enforces ZDR/data_collection=deny/no-fallback).
# Local/private escape hatch: set LLM_API_BASE_URL + LLM_MODEL_NAME + LLM_API_KEY to
#   point at a local OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp) for
#   restricted/MNPI work. The model must be multimodal if you want image support.
# Retired (must not be used): OLLAMA_API_KEY, VISION_MODEL_NAME,
# VISION_MODEL_BASE_URL, VISION_MODEL_API_KEY, CONTEXT7_API_KEY.

# ─── Core LLM ─────────────────────────────────────────────────────────
# Point Quiver at any OpenAI-compatible provider (Ollama, OpenRouter,
# OpenAI, vLLM, llama.cpp, etc.). The model must be multimodal if you
# want image support — Quiver sends image content parts to the same
# endpoint, there is no separate vision model.
#
# For cloud inference, use OpenRouter (the sole cloud gateway — see
# OPENROUTER_API_KEY below). For air-gapped / high-sensitivity work, point
# LLM_API_BASE_URL at a local OpenAI-compatible endpoint (vLLM, llama.cpp,
# LM Studio, etc.).
LLM_API_BASE_URL=
LLM_MODEL_NAME=
LLM_API_KEY=
# QUIVER_CHECKER_REMOTE_APPROVED=1

# ─── Sampling parameters (optional) ──────────────────────────────────
# Configurable per deployment. Models that don't support a parameter
# silently ignore it (OpenAI-compatible behavior).
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=
# LLM_TOP_K=
# Reasoning effort for thinking models (e.g. GPT-OSS, qwen3.5 thinking).
# Values: low, medium, high (model-dependent).
# LLM_REASONING_EFFORT=

# ─── Engagement profile and local tools (optional) ─────────────────────
# Enables finance-client defaults, including the consent gate.
# QUIVER_PROFILE=finance-client
# Override OfficeCLI discovery when it is not on PATH.
# QUIVER_OFFICECLI_PATH=
# Windows packaged installs may provide the exact daemon command used by
# Task Scheduler (the development default is node --import tsx ...).
# QUIVER_DAEMON_AUTOSTART_COMMAND=

# ─── Checker model (optional) ──────────────────────────────────────────
# Use a different model for the checker subagent than the maker.
# Falls back to the primary LLM model if not set.
# Prefer a multimodal model (text + images + documents): the checker attaches
# Evidence.json PDF/image/document sources natively via the same [File:] path
# as the maker (image_url / file parts). Do not use a text-only checker.
# On Vertex, checker URL is derived from VERTEX_PROJECT_ID when empty.
# CHECKER_LLM_MODEL_NAME=
# CHECKER_LLM_API_BASE_URL=
# Remote checker endpoints also require: QUIVER_CHECKER_REMOTE_APPROVED=1
# (Vertex BYOK auto-approves remote checker — customer knowingly uses GCP.)

# ─── Limits ───────────────────────────────────────────────────────────
# Context window budget. Leave headroom for output.
QUIVER_MAX_CONTEXT_TOKENS=120000

# ─── High-sensitivity local model (optional) ──────────────────────────
# When sensitivity routing classifies a turn as "high" (MNPI), the agent
# routes the model call here instead of the cloud endpoint. If not configured,
# high-sensitivity turns are REFUSED rather than sent to the cloud.
# QUIVER_LOCAL_LLM_API_BASE_URL=http://localhost:11434/v1
# QUIVER_LOCAL_LLM_MODEL_NAME=

# ─── Consent gate ─────────────────────────────────────────────────────
# finance-client enables this by default. Other deployments can opt in.
# Set QUIVER_CONSENT_GATE=0 only for a controlled development/test run.
# QUIVER_CONSENT_GATE=1

# ─── Security toggles ─────────────────────────────────────────────────
# Block scrape_url requests to private/internal IP ranges (default: enabled).
# Set to 0 to disable (not recommended).
# QUIVER_BLOCK_PRIVATE_IPS=1

# ─── Browser ──────────────────────────────────────────────────────────
# The browser runs headless by default. To show the window (e.g. manual
# sign-in), include browser:visible in QUIVER_AUTONOMY below.

# ─── Session logging ──────────────────────────────────────────────────
# Set to 0 to disable session logging.
QUIVER_SESSION_LOG=1
QUIVER_SESSION_LOG_MAX_CHARS=512

# ─── Web APIs (optional) ──────────────────────────────────────────────
# Powers: web_search, scrape_url, deep_research, find_all, entity_search.
# Get your key at https://platform.parallel.ai
PARALLEL_API_KEY=

# ─── OpenRouter — the sole cloud model gateway (ADR-001) ──────────────
# Recommended for cloud inference. The harness enforces provider.zdr=true,
# data_collection=deny, require_parameters=true, no fallback, no auto-router
# on every cloud request. Certified ModelProfile slugs ship in
# src/harness/model-profile.ts (e.g. openai-gpt-4o, anthropic-claude-sonnet).
# For restricted/MNPI work, leave this unset and use a local/private route.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PROFILE=

# ─── MCP (Model Context Protocol) ─────────────────────────────────────
# MCP servers are configured in .quiver/mcp.json (not .env).
# See .quiver/mcp.example.json for a sample config.
# MCP tools appear as mcp_<server>_<tool> in the tool list.
# Use /mcp to see connected servers.

# Autonomy grants — comma-separated capabilities the agent can use without asking,
# OR a trust tier: QUIVER_AUTONOMY=tier:build  (observe|propose|build|operate|yolo).
# Available grants: write_file,replace_content,apply_patch,run_command,destructive,
#   privileged,network,secrets,exfiltration,browser,browser:visible,
#   web,memory,todo,yolo
# Unset = conservative (ask for everything). yolo tier = bypass ALL gates + sandbox off.
QUIVER_AUTONOMY=
# Ambient self-heal + goal-loop: at task completion the harness runs the maker-checker
# (full) and auto-continues healing until it approves. Set 0 to disable. On by default.
QUIVER_AMBIENT=on
# Max self-heal rounds per ambient completion check (default 5).
# QUIVER_AMBIENT_MAX_ROUNDS=5
# Ambient log retention: auto-purge session logs older than N days at startup (0=keep forever).
QUIVER_LOG_RETENTION_DAYS=30
# Require a valid <document>_Evidence.json before an Office deliverable is
# marked final. Finance-client deployments keep this enabled.
QUIVER_EVIDENCE_REQUIRED=1
