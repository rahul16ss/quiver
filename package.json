{
  "name": "quiver-agent",
  "version": "1.0.0",
  "description": "Quiver: open foundation for controlled, source-backed document workflows in finance",
  "author": "rahul16ss",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "quiver": "./bin/quiver.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "examples",
    "packs",
    "profiles",
    "scripts",
    "skills",
    "templates",
    "workflow-packs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rahul16ss/quiver.git"
  },
  "homepage": "https://github.com/rahul16ss/quiver#readme",
  "bugs": {
    "url": "https://github.com/rahul16ss/quiver/issues"
  },
  "keywords": [
    "ai-agent",
    "finance",
    "document-workflow",
    "office",
    "evidence",
    "lineage",
    "open-source",
    "browser-ui",
    "loopback-daemon"
  ],
  "scripts": {
    "prepack": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "start": "node bin/quiver.js",
    "start:dev": "tsx src/cli.ts",
    "test": "tsx tests/run_tests.ts",
    "test:e2e": "npx tsx tests/e2e/run_e2e.ts --tier=a,b",
    "test:e2e:all": "npx tsx tests/e2e/run_e2e.ts --tier=all",
    "test:e2e:a": "npx tsx tests/e2e/run_e2e.ts --tier=a",
    "test:e2e:live": "npx tsx tests/e2e/run_e2e.ts --tier=c,d",
    "watchdog": "npx tsx scripts/watchdog.ts",
    "demo:ic-memo": "npx tsx examples/investment-committee-memo/scripts/run-demo.ts",
    "demo:ic-memo:live": "npx tsx examples/investment-committee-memo/scripts/run-live-demo.ts",
    "demo:post-earnings": "npx tsx workflow-packs/research/post-earnings-evidence-pack/scripts/run-demo.ts",
    "demo:portfolio-review": "npx tsx workflow-packs/wealth/portfolio-review-pack/scripts/run-demo.ts",
    "export:website-demo": "npx tsx examples/investment-committee-memo/scripts/export-website-demo.ts",
    "eval:routing": "tsx scripts/run_routing_eval.ts",
    "update-formula": "node scripts/update_formula.js",
    "harness": "node bin/quiver.js harness",
    "harness:dev": "tsx src/harness/launcher.ts harness"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@langchain/core": "1.2.4",
    "@langchain/langgraph": "1.4.9",
    "@langchain/openrouter": "0.4.5",
    "dotenv": "^16.4.7",
    "fastest-levenshtein": "^1.0.16",
    "parallel-web": "1.1.0",
    "picocolors": "^1.1.1",
    "puppeteer": "^25.2.1",
    "sharp": "^0.35.2",
    "string-width": "8.2.2",
    "wrap-ansi": "10.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
